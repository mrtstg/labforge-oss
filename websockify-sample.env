KEYCLOAK_CLIENT_ID=websockify
KEYCLOAK_CLIENT_SECRET=<SECRET>
# Proxmox console gateway. PROXMOX_API_TOKEN is the complete value of the
# Authorization header, including the PVEAPIToken= prefix.
PROXMOX_API_URL=https://proxmox.example:8006
PROXMOX_API_TOKEN=PVEAPIToken=user@pve!gateway=secret
# Optional PEM CA bundle for an internal Proxmox CA.
PROXMOX_CA_FILE=
# Development/private-network escape hatch; keep false in production.
PROXMOX_INSECURE_SKIP_VERIFY=false
