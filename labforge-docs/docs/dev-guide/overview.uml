@startuml
!theme plain
' Внешние потребители
actor "Пользователь" as user

' Единая точка входа
package "Пограничный слой" #EEF7FF {
  artifact nginx
}

' Авторизация
package "Авторизация" #FFF7EE {
  artifact Keycloak
  component "auth-service" as au
  person "LDAP/AD/FreeIPA" as ldap
}

package "Служебные сервисы" #F5FFF5 {

  package "Конвейер развертывания" #E8F7E8 {
    component "cluster-manager" as cm
    component "deployment-api" as da
    component "jobservice-api" as ja
    component "jobservice" as jw
  }

  package "Интеграции и шлюзы" #E8EFF7 {
    component "frontend-server" as fe
    component "websockify-go" as ws
    component "kroki-proxy" as kp
  }

  cm <-left-> da
  jw <-up- cm
  jw <-up-> ja
  ja --> da

  fe --> kp
  fe --> cm
  fe --> da
  fe --> ja
  fe --> au
  ws --> cm
  ws --> da
  kp --> da
}

' Мониторинг
package "Мониторинг" #F5F0FF {
  artifact Grafana
  artifact Alloy
  artifact Loki
  database Prometheus
  artifact Cadvisor
  artifact "nginx-prometheus-exporter" as nginxe
}

' Инфраструктура
package "Инфраструктура" #FFF5FA {
  database PostgreSQL
  queue RabbitMQ
  artifact Redis
  artifact Kroki
}

' Целевые гипервизоры
package "Кластер Proxmox (узлы 1..N)" #FFFFE6 {
  component "Proxmox API" as pveapi
  entity "VNC-подключение" as vnc
}

user -> nginx

nginx --> fe
nginx --> da
nginx --> Grafana
nginx --> ws

nginxe --> nginx
Prometheus --> nginxe
Prometheus --> Cadvisor
Alloy --> Loki
Alloy --> Prometheus
Grafana --> Prometheus
Grafana --> Loki

da --> PostgreSQL
da --> pveapi
da --> Redis
da --> au

cm --> PostgreSQL
cm --> pveapi
cm --> au

jw --> RabbitMQ

ja --> RabbitMQ
ja --> Redis

au --> Keycloak
au --> Redis
Keycloak --> ldap

kp --> Kroki
kp --> Redis

ws --> au
ws --> pveapi
ws --> vnc

@enduml
