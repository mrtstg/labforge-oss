POSTGRES_USER=dbuser
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=dbpass
POSTGRES_DB=labforge
PGDATA=/data/postgres
POSTGRES_MULTIPLE_DATABASES=keycloak

KEYCLOAK_REALM=ln2

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=dbuser
KC_DB_PASSWORD=dbpass
KC_HOSTNAME=https://<KC>
FRONTEND_HOSTNAME=https://<FRONT>
FRONTEND_DOMAIN=<FRONT>

RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=rbpass

GRAFANA_ADMIN_PASSWORD=P@ssw0rd

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASS=rbpass

AUTH_URL=http://auth:8000
CLUSTER_URL=http://cluster:8000
DEPLOYMENT_URL=http://deployment:8000
KROKI_URL=http://kroki:8000
JOBSERVICE_URL=http://jobservice-api:8000

# Proxmox console gateway. PROXMOX_API_TOKEN is the complete value of the
# Authorization header, including the PVEAPIToken= prefix.
PROXMOX_API_URL=https://proxmox.example:8006
PROXMOX_API_TOKEN=PVEAPIToken=user@pve!gateway=secret
# Optional PEM CA bundle for an internal Proxmox CA.
PROXMOX_CA_FILE=
# Development/private-network escape hatch; keep false in production.
PROXMOX_INSECURE_SKIP_VERIFY=false
